# Variables de entorno para producción (Render)
# Copia este archivo como .env y configura los valores

# API Key de Google Gemini
GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# Credenciales de Gmail
GMAIL_USER=tu_email@gmail.com
GMAIL_APP_PASSWORD=tu_app_password_16_caracteres

# API Key para OpenClaw (genera una cadena segura, ej: openssl rand -hex 32)
OPENCLAW_API_KEY=tu_api_key_secreta_aqui